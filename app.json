{
  "expo": {
    "name": "Arara Carioca",
    "slug": "arara-carioca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main_character/tico-azul-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/main_character/tico-azul-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tavaressan.araracarioca"
    },
    "web": {
      "favicon": "./assets/images/main_character/tico-azul-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c7f2fd35-b99b-4d85-a9b0-0e1aa381ae2b"
      }
    },
    "owner": "tavaressan"
  }
}